rules_version = '2';

// Cloud save rules for the username/password accounts.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // A player reads and writes only their own save document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Username reservations are world-readable so sign-up can check
    // availability, but each one can only be claimed once, by its owner.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
