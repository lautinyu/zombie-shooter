rules_version = '2';

// Cloud save rules for the username/password accounts.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    // A player reads and writes only their own save document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Username reservations are world-readable so sign-up can check
    // availability, but each one can only be claimed once, by its owner.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Endless Horde leaderboard: world-readable, one best-run document per
    // player, written only by its owner and shape-checked.
    match /hordeLeaderboard/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'waves', 'kills', 'seconds', 'className', 'updatedAt'])
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 16
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 16
        && request.resource.data.waves is int
        && request.resource.data.waves >= 1
        && request.resource.data.waves <= 5000
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0
        && request.resource.data.kills <= 1000000
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 0
        && request.resource.data.updatedAt is int;
      allow delete: if false;
    }
  }
}
